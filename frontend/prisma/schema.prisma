generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Division {
  id     String  @id @default(uuid())
  name   String  @unique
  shifts Shift[]
  users  User[]
}

model Shift {
  id                   String               @id @default(uuid())
  name                 String
  description          String?
  checkInTime          String
  checkOutTime         String
  divisionId           String
  division             Division             @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  locationId           String?
  location             Location?            @relation(fields: [locationId], references: [id])
  schedules            Schedule[]
  currentShiftRequests ShiftChangeRequest[] @relation("CurrentShift")
  newShiftRequests     ShiftChangeRequest[] @relation("NewShift")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  dob                 String
  role                String               @default("Karyawan")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  photo               String?
  divisionId          String?
  attendances         Attendance[]
  schedules           Schedule[]
  shiftChangeRequests ShiftChangeRequest[]
  division            Division?            @relation(fields: [divisionId], references: [id])
}

model Schedule {
  id        String   @id @default(uuid())
  userId    String
  shiftId   String
  date      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
}

model Attendance {
  id        String   @id @default(uuid())
  userId    String
  type      String
  location  String
  photo     String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId])
}

model ShiftChangeRequest {
  id              String   @id @default(uuid())
  userId          String
  currentShiftId  String
  newShiftId      String
  requestDate     String   // Format: YYYY-MM-DD
  reason          String
  status          String   @default("pending") // pending, approved, rejected
  adminNote       String?  // Catatan admin saat approve/reject
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentShift    Shift    @relation("CurrentShift", fields: [currentShiftId], references: [id])
  newShift        Shift    @relation("NewShift", fields: [newShiftId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestDate])
}

model Location {
  id        String   @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  radius    Int      @default(50)
  createdAt DateTime @default(now())
  shifts    Shift[]
}
